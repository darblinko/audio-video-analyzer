# Environment variables read by the API server. All are optional.
# Copy to .env in the repository root: cp .env.example .env

# Gemini video description. Without a key the Gemini step is skipped and audio analysis runs.
# Setting a key means recorded video is uploaded to the Google Gemini Files API.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=120

# Where the SQLite database and in-flight uploads are written. Both are gitignored.
AVA_DATA_DIR=data
# Keep uploaded media after analysis (default: deleted when the run ends).
AVA_KEEP_UPLOADS=0
AVA_MAX_UPLOAD_MB=50
# Reject clips longer than this before decoding.
AVA_MAX_AUDIO_SECONDS=300
# Feature extractions that may run at once.
AVA_MAX_CONCURRENT_ANALYSES=2

# Server bind address and allowed browser origins.
AVA_HOST=127.0.0.1
AVA_PORT=8000
AVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
